NODE_ENV=development
HOST=0.0.0.0
PORT=4000
DATA_FILE=./data/roqlock.json
PAYMENT_SIMULATOR_ENABLED=true
JWT_SECRET=replace-with-at-least-32-random-characters
PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Contract integration is read-only until signing and payment custody are explicitly designed.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_CHAIN_ID=84532
ROQLOCK_ESCROW_ADDRESS=0x30315c49b2ACfa541E09FfAA181C29547DF39de3
MOCK_USDC_ADDRESS=0x958F019a07B239695E8aD350539d5B70A63Ef841
MIN_CHAIN_CONFIRMATIONS=2

# Current RAS API uses x-staging-api-key. Do not use the live key in this environment.
ROQQU_BASE_URL=https://service.roqqu.com/v1
ROQQU_TEST_API_KEY=
ROQQU_TEST_PRIVATE_KEY=
ROQQU_TEST_PUBLIC_KEY=
